DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better Auth – generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# public URL of this API
BETTER_AUTH_URL=http://localhost:3000
# where the frontend runs; comma-separate several
FRONTEND_URL=http://localhost:5173

# optional: temporary password for the first admin created by `npm run db:seed`
# (otherwise one is generated and printed)
SEED_ADMIN_PASSWORD=
