DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better Auth – generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# public URL of this API
BETTER_AUTH_URL=http://localhost:3000
# where the frontend runs; comma-separate several
FRONTEND_URL=http://localhost:5173
# where the campaign forms (campaigns/) run: allowed to call /api/public, and
# used for each campaign's link in the CRM; comma-separate several, the first is the link
CAMPAIGN_FORM_URL=http://localhost:5174
# Cloudflare Turnstile secret key: checks the bot-protection token sent with
# each campaign form submission (the site key goes in campaigns/)
TURNSTILE_SECRET_KEY=

# optional: temporary password for the first admin created by `npm run db:seed`
# (otherwise one is generated and printed)
SEED_ADMIN_PASSWORD=
