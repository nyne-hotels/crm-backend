DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better Auth – generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# public URL of this API
BETTER_AUTH_URL=http://localhost:3000
# where the frontend runs; comma-separate several
FRONTEND_URL=http://localhost:5173
# where the campaign forms (campaigns/) run: allowed to call /api/public, and
# used for each campaign's link in the CRM; comma-separate several, the first is the link
CAMPAIGN_FORM_URL=http://localhost:5174
# Cloudflare Turnstile secret key: checks the bot-protection token sent with
# each campaign form submission (the site key goes in campaigns/)
TURNSTILE_SECRET_KEY=

# optional: temporary password for the first admin created by `npm run db:seed`
# (otherwise one is generated and printed)
SEED_ADMIN_PASSWORD=

# Mailchimp, for campaign reports (Campaigns → a campaign). Create a key in
# Mailchimp: profile → Profile → Extras → API keys. It ends in the data
# centre, e.g. …-us3. Keys expire a year after they're created; the CRM then
# says so on the campaign pages. Restart the API after changing it.
MAILCHIMP_API_KEY=
# Mailchimp's webhook, which tells the CRM at once when someone unsubscribes or
# an address bounces (a daily check catches anything missed). Any random text of
# 24+ characters, e.g. from `openssl rand -hex 24`. Admins see the address to
# paste into Mailchimp on Marketing → Unsubscribes & bounces. The address is
# built from MAILCHIMP_WEBHOOK_BASE_URL, or BETTER_AUTH_URL when that's empty,
# and must be public (https) for Mailchimp to reach it.
MAILCHIMP_WEBHOOK_SECRET=
MAILCHIMP_WEBHOOK_BASE_URL=
# MAILCHIMP_SYNC=off stops the automatic syncs (campaigns and unsubscribes)
